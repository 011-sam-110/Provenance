# local dev build
.next-dev/

# Isolated verification builds (TN_DIST_DIR)
.next-*/

# The raw 34 MB HYG download that scripts/gen-sky.mjs caches so a re-run costs
# nothing. The COMMITTED artefact is public/sky/naked-eye.json, which is generated
# from it; this is just the working copy and must never reach the repo.
.sky-cache/

# Never let an ad-hoc credential probe land in the repo
tok.json
login_out.json
me.json
read*.json

# Local perf profiling output (scripts/profile-map.mjs) and its isolated build dir
profile-out/
.next-perf/

.env*

# Scratch working directory: throwaway probes, backups and captured output.
# Excluded from tsconfig too -- a stale copy of a real file in here was gating
# `tsc --noEmit` on an import that no longer existed.
scratchpad/

# Stage A liveness harness: raw upstream bodies saved before anything is decided, so
# `scripts/liveness-measure.mts --replay` can re-run the whole scan with no network.
# 5.5 MB of other people's public JSON, regenerable in one command, and the conclusions
# it supports are committed in data/liveness/report.json. The fixtures are the working
# note, not the finding.
data/liveness/raw/

# Raw GDELT windows recorded by scripts/gdelt-record.mts. Multi-MB per 15-min
# slot; the audit replays from these, and only the labelled subset is committed.
.gdelt-cache/
